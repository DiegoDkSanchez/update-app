rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the pre-existing policy for unrelated applications in this project.
    // These legacy collections still need a separate security review.
    match /{legacyCollection}/{document=**} {
      allow read, write: if legacyCollection != 'updateGroups';
    }
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function owner(groupId) { return signedIn() && get(/databases/$(database)/documents/updateGroups/$(groupId)).data.ownerId == request.auth.uid; }
    function validGroup(d) {
      return d.keys().hasOnly(['title', 'description', 'ownerId', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.description is string && d.description.size() <= 400
        && d.ownerId is string && d.createdAt is number;
    }
    function validItem(d) {
      return d.keys().hasOnly(['name', 'purchase', 'amount', 'done', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.purchase is string && d.purchase.size() > 0 && d.purchase.size() <= 200
        && d.amount is number && d.amount >= 0 && d.amount <= 1000000
        && d.done is bool && d.createdAt is number;
    }
    match /updateGroups/{groupId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && validGroup(request.resource.data);
      allow update: if owner(groupId) && validGroup(request.resource.data) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /items/{itemId} {
        allow read: if exists(/databases/$(database)/documents/updateGroups/$(groupId));
        allow create, update: if owner(groupId) && validItem(request.resource.data);
        allow delete: if owner(groupId);
      }
    }
  }
}
